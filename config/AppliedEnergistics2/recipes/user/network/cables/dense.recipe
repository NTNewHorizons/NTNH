# Dense Smart Cable (CableDense) recipes - NTNH 2.15.0 (issue #207)
# This file shadows config/AppliedEnergistics2/recipes/generated/network/cables/dense.recipe
# because AE2's ConfigLoader prefers identically named files under recipes/user/.
# Keep the full original set below and only add the new smart-cable based recipe.

# 4x covered cable + dusts -> dense smart cable (vanilla behaviour, kept for compat)
shapeless=
    ae2:CableCovered ae2:CableCovered ae2:CableCovered ae2:CableCovered 
    oredictionary:dustRedstone oredictionary:dustGlowstone
    -> ae2:CableDense.Fluix

# 4x smart cable + dusts -> dense smart cable (issue #207)
shapeless=
    ae2:CableSmart ae2:CableSmart ae2:CableSmart ae2:CableSmart
    oredictionary:dustRedstone oredictionary:dustGlowstone
    -> ae2:CableDense.Fluix

shapeless=
    ae2:CableDense mc:water_bucket
    -> ae2:CableDense.Fluix

shaped=
    ae2:CableDense ae2:CableDense ae2:CableDense,
    ae2:CableDense oredictionary:dyeWhite ae2:CableDense,
    ae2:CableDense ae2:CableDense ae2:CableDense
    -> 8 ae2:CableDense.White

