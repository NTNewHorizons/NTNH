ch as the §3Smoker§r, which cooks food faster, and the §3Blast Furnace§r, which smelts ores faster.",\n          "globalShare:1": 0,\n          "icon:10": {\n            "Count:3": 1,\n            "Damage:2": 0,\n            "OreDict:8": "",\n            "id:8": "hbm:tile.furnace_iron"\n          },\n          "isMain:1": 0,\n          "isSilent:1": 0,\n          "lockedProgress:1": 0,\n          "name:8": "Better Furnaces",\n          "notification_duration:5": -1.0,\n          "notification_effect:3": -1,\n          "notification_fade_in:5": -1.0,\n          "notification_fade_out:5": -1.0,\n          "notification_icon_offset_y:3": -2147483648,\n          "notification_icon_scale:5": -1.0,\n          "notification_pos_x:3": -2147483648,\n          "notification_pos_y:3": -2147483648,\n          "notification_show_icon:8": "default",\n          "notification_style:8": "default",\n          "notification_subtitle:8": "",\n          "notification_subtitle_scale:5": -1.0,\n          "notification_title:8": "",\n          "notification_title_scale:5": -1.0,\n          "particle_count:3": -1,\n          "questLogic:8": "AND",\n          "repeatTime:3": -1,\n          "repeat_relative:1": 1,\n          "simultaneous:1": 0,\n          "snd_complete:8": "random.levelup",\n          "snd_update:8": "random.levelup",\n          "taskLogic:8": "OR",\n          "visibility:8": "NORMAL"\n        }\n      },\n      "questIDHigh:4": -9177172482455221374,\n      "questIDLow:4": -6300314152617983166,\n      "rewards:9": {},\n      "tasks:9": {\n        "0:10": {\n          "autoConsume:1": 0,\n          "consume:1": 0,\n          "groupDetect:1": 0,\n          "ignoreNBT:1": 1,\n          "index:3": 0,\n          "partialMatch:1": 1,\n          "requireOnlyOneItem:1": 0,\n          "requiredItems:9": {\n            "0:10": {\n              "Count:3": 1,\n              "Damage:2": 0,\n              "OreDict:8": "",\n              "id:8": "hbm:tile.machine_furnace_brick_off"\n      