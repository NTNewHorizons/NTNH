"",\n          "notification_subtitle_scale:5": -1.0,\n          "notification_title:8": "",\n          "notification_title_scale:5": -1.0,\n          "particle_count:3": -1,\n          "questLogic:8": "AND",\n          "repeatTime:3": -1,\n          "repeat_relative:1": 1,\n          "simultaneous:1": 0,\n          "snd_complete:8": "random.levelup",\n          "snd_update:8": "random.levelup",\n          "taskLogic:8": "AND",\n          "visibility:8": "NORMAL"\n        }\n      },\n      "questIDHigh:4": 6655386366404936121,\n      "questIDLow:4": -8667935297884431914,\n      "rewards:9": {},\n      "tasks:9": {\n        "0:10": {\n          "index:3": 0,\n          "taskID:8": "bq_standard:checkbox"\n        }\n      }\n    },\n    "296:10": {\n      "preRequisites:9": {\n        "0:10": {\n          "questIDHigh:4": 0,\n          "questIDLow:4": 19\n        },\n        "1:10": {\n          "questIDHigh:4": 0,\n          "questIDLow:4": 37,\n          "type:1": 1\n        }\n      },\n      "properties:10": {\n        "betterquesting:10": {\n          "autoClaim:1": 0,\n          "completion_animation:8": "default",\n          "completion_particle:8": "default",\n          "confetti_icon:10": {\n            "Count:3": 0,\n            "Damage:2": 0,\n            "OreDict:8": "",\n            "id:8": "minecraft:stick"\n          },\n          "countAsQuest:1": 1,\n          "desc:8": "The §3Radial Performance Engine§r is a combustion generator that converts liquid fuels into electrical power. It requires a minimum of §e3§r §6Combustion Engine Pistons§r to run, with up to §e9§r installed in its piston slots. Additional pistons increase both power output and fuel consumption linearly.\n\nThe engine accepts fuels of varying grades at different efficiency rates. §bHeating Oil§r and §bIndustrial Oil§r burn at §e75%§r efficiency, §bPetroil§r at §e50%§r, and §bDiesel§r and §bGasoline§r at §e25%§r. Aviation fuels and gaseous fuels are not compatible. Power is output from the bottom face, and the engine stores up to §e250 kHE§r internally, or §e2.5 MHE§r when running §bNITAN§r.\n\nHowever, the engine is most efficient with the heaviest, least-refined feedstocks. Lighter refined fuels produce less power per mB despite their higher grade.\n\n§2The listed efficiency is a multiplier on each fuel\u0027s base combustion energy. Higher-grade fuels may have higher base energy, so check the HE/t display in the GUI before settling on a fuel.",\n          "globalShare:1": 0,\n          "icon:10": {\n            "Count:3": 1,\n            "Damage:2": 0,\n            "OreDict:8": "",\n            "id:8": "hbm:tile.machine_selenium"\n          },\n          "isMain:1": 1,\n          "isSilent:1": 0,\n          "lockedProgress:1": 0,\n          "name:8": "Radial Performance Engine",\n          "notification_duration:5": -1.0,\n          "notification_effect:3": -1,\n          "notification_fade_in:5": -1.0,\n          "notification_fade_out:5": -1.0,\n          "notification_icon_offset_y:3": -2147483648,\n          "notification_icon_scale:5": -1.0,\n          "notification_pos_x:3": -2147483648,\n          "notification_pos_y:3": -2147483648,\n          "notification_show_icon:8": "default",\n          "notification_style:8": "default",\n          "notification_subtitle:8": "",\n          "notification_subtitle_scale:5": -1.0,\n          "notification_title:8": "",\n          "notification_title_scale:5": -1.0,\n          "particle_count:3": -1,\n          "questLogic:8": "AND",\n          "repeatTime:3": -1,\n          "repeat_relative:1": 1,\n          "simultaneous:1": 0,\n          "snd_complete:8": "random.levelup",\n          "snd_update:8": "random.levelup",\n          "taskLogic:8": "AND",\n          "visibility:8": "NORMAL"\n        }\n      },\n      "questIDHigh:4": 6688386802871848693,\n      "questIDLow:4": -4794614385188764650,\n      "rewards:9": {},\n      "tasks:9": {\n        "0:10": {\n          "autoConsume:1": 0,\n          "