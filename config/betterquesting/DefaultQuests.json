artialMatch:1": 1,\n          "requireOnlyOneItem:1": 0,\n          "requiredItems:9": {\n            "0:10": {\n              "Count:3": 1,\n              "Damage:2": 0,\n              "OreDict:8": "",\n              "id:8": "hbm:tile.machine_purex"\n            }\n          },\n          "taskID:8": "bq_standard:retrieval"\n        }\n      }\n    },\n    "334:10": {\n      "preRequisites:9": {\n        "0:10": {\n          "questIDHigh:4": 0,\n          "questIDLow:4": 82\n        },\n        "1:10": {\n          "questIDHigh:4": -8230734542605238237,\n          "questIDLow:4": -9014159122841897299\n        }\n      },\n      "properties:10": {\n        "betterquesting:10": {\n          "autoClaim:1": 0,\n          "completion_animation:8": "default",\n          "completion_particle:8": "default",\n          "confetti_icon:10": {\n            "Count:3": 0,\n            "Damage:2": 0,\n            "OreDict:8": "",\n            "id:8": "minecraft:stick"\n          },\n          "countAsQuest:1": 1,\n          "desc:8": "The §3Chicago Pile§r is a modular breeding reactor with no GUI, built to transmute §6Natural Uranium§r into plutonium isotopes through neutron bombardment. It must be operated manually or via §dRedstone-over-Radio§r.\n\nBuild a rectangular prism of §6Chicago Pile Graphite Bricks§r, at minimum 5*5*5 and at most 15*15*15. Once assembled, drill a non-edge block on one of its lateral faces with the §6Hand Drill§r to establish the core and fix the reactor\u0027s channel orientation. Channels are straight lines drilled through the pile and may not intersect. Fuel channels share the core\u0027s face orientation and accept rods via a §3Chicago Pile Fuel Loader§r on the input port; spent rods are ejected from the opposite side. Ventilation channels run perpendicular to the core and require a §3Chicago Pile Vent§r supplied with §bcompressed air§r at §e1 PU§r - each vent cools only the fuel channels within one block above or below it. Vertical control rod channels are optional and reduce reactivity between channels. \n\nEvery reaction requires a neutron source. The §6Ra226Be Neutron Source§r is the starter option; the more powerful §6Po210Be Neutron Source§r can replace it later. §6Natural Uranium Rods§r breed into §6Plutonium-239 Rods§r, which can be bred further into §6Reactor-Grade Plutonium Rods§r. Leaving fuel beyond that point produces §6Nuclear Waste Rods§r, which generate extreme heat and risk meltdown. To safely push out spent rods without fresh fuel, use §6Zirconium Rods§r - they are inert and transparent to neutrons.\n\n§2Verify cooling is working before loading any fuel. The pile melts down at 800°C, causing an explosion and widespread fire.\n\nThe quest asks for a §3Chicago Pile§r of at least 5*5*5 with a core established, a §3Chicago Pile Fuel Loader§r and §3Chicago Pile Vent§r attached, and a §6Ra226Be Neutron Source§r loaded alongside at least one §6Natural Uranium Rod§r.",\n          "globalShare:1": 0,\n          "icon:10": {\n            "Count:3": 1,\n            "Damage:2": 0,\n            "OreDict:8": "",\n            "id:8": "hbm:tile.pile_brick"\n          },\n          "isMain:1": 1,\n          "isSilent:1": 0,\n          "lockedProgress:1": 0,\n          "name:8": "Chicago Pile",\n          "notification_duration:5": -1.0,\n          "notification_effect:3": -1,\n          "notification_fade_in:5": -1.0,\n          "notification_fade_out:5": -1.0,\n          "notification_icon_offset_y:3": -2147483648,\n          "notification_icon_scale:5": -1.0,\n          "notification_pos_x:3": -2147483648,\n          "notification_pos_y:3": -2147483648,\n          "notification_show_icon:8": "default",\n          "notification_style:8": "default",\n          "notification_subtitle:8": "",\n          "notification_subtitle_scale:5": -1.0,\n          "notification_title:8": "",\n          "notification_title_scale:5": -1.0,\n          "particle_count:3": -1,\n          "questLogic:8": "AND",\n          "repea