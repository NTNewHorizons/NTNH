from machines. §3Exhaust Pipes§r, made in anvils, can be used to transport the fumes to the Smokestack. The §3Industrial Smokestack§r is needed to produce §6Fine Soot§r, required for making §6Fullerite§r in the late game.\n\nAn §3Ashpit§r can be installed beneath the Smokestack which will collect §6Ash§r, that can be used as a cheap black dye alternative as well as in the creation of §6Industrial Fertilizer§r.",\n          "globalShare:1": 0,\n          "icon:10": {\n            "Count:3": 1,\n            "Damage:2": 0,\n            "OreDict:8": "",\n            "id:8": "hbm:tile.chimney_brick"\n          },\n          "isMain:1": 0,\n          "isSilent:1": 0,\n          "lockedProgress:1": 0,\n          "name:8": "Pollution and Smokestack",\n          "notification_duration:5": -1.0,\n          "notification_effect:3": -1,\n          "notification_fade_in:5": -1.0,\n          "notification_fade_out:5": -1.0,\n          "notification_icon_offset_y:3": -2147483648,\n          "notification_icon_scale:5": -1.0,\n          "notification_pos_x:3": -2147483648,\n          "notification_pos_y:3": -2147483648,\n          "notification_show_icon:8": "default",\n          "notification_style:8": "default",\n          "notification_subtitle:8": "",\n          "notification_subtitle_scale:5": -1.0,\n          "notification_title:8": "",\n          "notification_title_scale:5": -1.0,\n          "particle_count:3": -1,\n          "questLogic:8": "AND",\n          "repeatTime:3": -1,\n          "repeat_relative:1": 1,\n          "simultaneous:1": 0,\n          "snd_complete:8": "random.levelup",\n          "snd_update:8": "random.levelup",\n          "taskLogic:8": "OR",\n          "visibility:8": "NORMAL"\n        }\n      },\n      "questIDHigh:4": 0,\n      "questIDLow:4": 202,\n      "rewards:9": {\n        "0:10": {\n          "ignoreDisabled:1": 0,\n          "index:3": 0,\n          "rewardID:8": "bq_standard:item",\n          "rewards:9": {\n            "0:10": {\n      