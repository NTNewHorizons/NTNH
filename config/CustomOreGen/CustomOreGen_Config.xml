<!-- =================================================================
     NTNH Master Custom Ore Generation Configuration
     Optimized modular loader for Minecraft 1.7.10 / Forge.
     ================================================================= -->
<Config>

    <!-- Master Engine Settings & Global Parameters -->
    <ConfigSection>

        <OptionDisplayGroup name="groupGeneral" displayName="General" displayState="shown">
            <Description>Global options affecting all ore distributions in NTNH.</Description>
        </OptionDisplayGroup>

        <!-- Balanced production frequencies -->
        <OptionNumeric name="oreFreq" default="1" min="0" max="5" displayState="shown" displayGroup="groupGeneral">
            <Description>A global multiplier for the frequency of all ore distributions.</Description>
            <DisplayName>Ore Frequency</DisplayName>
        </OptionNumeric>

        <OptionNumeric name="oreSize" default="1" min="0" max="5" displayState="shown" displayGroup="groupGeneral">
            <Description>A global multiplier for the size of all ore distributions.</Description>
            <DisplayName>Ore Deposit Size</DisplayName>
        </OptionNumeric>

        <OptionChoice name="populate" default="true" displayGroup="groupGeneral">
            <Description>Controls whether COG adds ores to chunks.</Description>
            <DisplayName>Populate</DisplayName>
            <Choice value="true" displayValue="On" />
            <Choice value="false" displayValue="Off" />
        </OptionChoice>

        <!-- CPU Optimization: Cancel redundant vanilla ore passes to save chunk generation time -->
        <OptionChoice name="vanillaOreGen" default="false" displayGroup="groupGeneral">
            <Description>
                Controls vanilla Minecraft ore generators (coal, iron, gold, redstone, lapis, diamond).
                Disabled in NTNH to eliminate redundant vanilla generation passes and improve chunk generation performance.
            </Description>
            <DisplayName>Vanilla Ore Gen.</DisplayName>
            <Choice value="true" displayValue="On" />
            <Choice value="false" displayValue="Off" />
        </OptionChoice>

        <!-- Memory Optimization: Constrain deferred chunk population radius -->
        <OptionNumeric name="deferredPopulationRange" default="16" displayGroup="groupGeneral">
            <Description>
                Radius (in blocks) around a chunk that must be generated before COG decorates it.
            </Description>
            <DisplayName>Deferred Chunk Gen. Range</DisplayName>
            <Min>0</Min>
            <Max>128</Max>
            <DisplayIncrement>16</DisplayIncrement>
        </OptionNumeric>

        <OptionChoice name="debugMode" default="false" displayState="shown_dynamic" displayGroup="groupGeneral">
            <Description>Enable/disable debugging mode and wireframe models.</Description>
            <DisplayName>Debugging Mode</DisplayName>
            <Choice value="true" displayValue="On" />
            <Choice value="false" displayValue="Off" />
        </OptionChoice>

        <OptionChoice name="advOptions" default="false" displayState="shown_dynamic" displayGroup="groupGeneral">
            <Description>Enable/disable advanced options for individual distributions.</Description>
            <DisplayName>Advanced Options</DisplayName>
            <Choice value="true" displayValue="On" />
            <Choice value="false" displayValue="Off" />
        </OptionChoice>

    </ConfigSection>

    <!-- ******************** Import Custom Modules ******************** -->
    <OptionalImport file="modules/custom/*.xml" />

</Config>
